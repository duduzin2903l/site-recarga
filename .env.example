ACTIVE_GATEWAY=sharpify
SHARPIFY_CLIENT_ID=
SHARPIFY_CLIENT_SECRET=

# Credencial criada na UTMify em Integrações > Webhooks > Credenciais de API.
# Usada somente no servidor para registrar PIX gerado e pagamento aprovado.
UTMIFY_API_TOKEN=

# Optional: configure the URL generated by UTMify (or another receiver) so
# Sharpify can notify approved/cancelled payments even after the customer
# closes the browser.
SHARPIFY_WEBHOOK_URL=
